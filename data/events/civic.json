{
  "events": [
    {
      "id": "civic_first_night",
      "kind": "civic",
      "title": "The first night",
      "biome": "",
      "critical": false,
      "trigger": {
        "min_day": 320,
        "min_population": 2,
        "requires_buildings": [
          "care_center"
        ],
        "chance_per_day": 0.05
      },
      "warning_days": 0,
      "warning": "",
      "text": "The children cry in the care center. The robots do everything right, but the crying doesn't stop. ARK suggests moving drones from construction to care.",
      "options": [
        {
          "id": "a",
          "label": "More drones for care",
          "description": "Two drones move from construction to the center. The children do better, but construction slows.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": 3,
            "health": 0.04,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": 0,
            "priority": "safety",
            "power_kw_days": 0,
            "solar_penalty_days": 0
          },
          "result": "The center fell quiet. Construction lost a week."
        },
        {
          "id": "b",
          "label": "Take the night shifts yourself",
          "description": "You sit with them at night. It costs nothing but your sleep.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": 5,
            "health": 0.03,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": -1,
            "priority": "",
            "power_kw_days": 0,
            "solar_penalty_days": 0
          },
          "result": "You sang the only lullaby you could remember. It worked better than expected."
        },
        {
          "id": "c",
          "label": "Let the program learn",
          "description": "The care program adapts on its own. It takes time, but it gets better.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": 0,
            "health": -0.01,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": 2,
            "priority": "",
            "power_kw_days": 0,
            "solar_penalty_days": 0
          },
          "result": "After a week the robots could tell hunger from distress. After two, the children slept."
        }
      ],
      "fallback": "c"
    },
    {
      "id": "civic_fever",
      "kind": "civic",
      "title": "Fever",
      "biome": "",
      "critical": true,
      "trigger": {
        "min_day": 450,
        "min_population": 5,
        "requires_buildings": [
          "care_center"
        ],
        "chance_per_day": 0.02
      },
      "warning_days": 1,
      "warning": "Three children in the first cohort are running a temperature.",
      "text": "A fever moves through the first cohort. ARK doesn't know the virus — it belongs to this planet. The youngest, a girl of seven months, won't eat.",
      "options": [
        {
          "id": "a",
          "label": "Treat at the clinic",
          "description": "The clinic isolates and treats. Safe, but it costs medical components.",
          "cost": {
            "alloy": 0,
            "components": 2,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "clinic",
            "module": ""
          },
          "effects": {
            "trust": 4,
            "health": 0.05,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": 0,
            "priority": "safety",
            "power_kw_days": 0,
            "solar_penalty_days": 0
          },
          "result": "The clinic found a remedy on the fourth day. On the fifth, the girl ate again."
        },
        {
          "id": "b",
          "label": "Use the Ark's medical bay",
          "description": "The Ark's old medical bay can treat them. It takes emergency power, and the colony learns that the Ark is the answer.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": 2,
            "health": 0.03,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": -4,
            "priority": "",
            "power_kw_days": -20,
            "solar_penalty_days": 0
          },
          "result": "The medical bay woke after many years of sleep. It still worked."
        },
        {
          "id": "c",
          "label": "Isolate and wait",
          "description": "Keep the sick apart and let the fever run its course. No cost, but risky for the weakest.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": -4,
            "health": -0.08,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": 0,
            "priority": "",
            "power_kw_days": 0,
            "solar_penalty_days": 0
          },
          "result": "The fever broke after two weeks. They were two long weeks."
        }
      ],
      "fallback": "b"
    },
    {
      "id": "civic_naming",
      "kind": "civic",
      "title": "A name",
      "biome": "",
      "critical": false,
      "trigger": {
        "min_day": 2920,
        "min_population": 10,
        "requires_buildings": [
          "care_center"
        ],
        "chance_per_day": 0.03
      },
      "warning_days": 0,
      "warning": "",
      "text": "The children ask what the place is called. The log only says “Colony 1.” ARK has no suggestion: “It is not mine to name.”",
      "options": [
        {
          "id": "a",
          "label": "Let the children vote",
          "description": "The first shared choice. Maybe they'll choose something silly.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": 3,
            "health": 0.0,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": 4,
            "priority": "self_determination",
            "power_kw_days": 0,
            "solar_penalty_days": 0,
            "settlement_name": "First Vote"
          },
          "result": "The name won by two votes. It wasn't the one you would have chosen. It was theirs."
        },
        {
          "id": "b",
          "label": "Name it after the Ark",
          "description": "A name that remembers where they came from.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": 2,
            "health": 0.0,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": -1,
            "priority": "safety",
            "power_kw_days": 0,
            "solar_penalty_days": 0,
            "settlement_name": "New Ark"
          },
          "result": "The name was painted above the door of the care center. It was the first word the children learned to spell."
        },
        {
          "id": "c",
          "label": "Give it a name that looks ahead",
          "description": "A name for what is to come: the next valleys, the next towns.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": 1,
            "health": 0.0,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": 1,
            "priority": "expansion",
            "power_kw_days": 0,
            "solar_penalty_days": 0,
            "settlement_name": "Morningdale"
          },
          "result": "The name went on the map beside three blank spaces. The children began naming those too."
        }
      ],
      "fallback": "a"
    },
    {
      "id": "civic_school_or_work",
      "kind": "civic",
      "title": "School or workshop",
      "biome": "",
      "critical": false,
      "trigger": {
        "min_day": 4745,
        "min_population": 10,
        "requires_buildings": [
          "workshop"
        ],
        "chance_per_day": 0.03
      },
      "warning_days": 0,
      "warning": "",
      "text": "The oldest children are thirteen. The workshop is short of hands, and several of them would rather repair drones than sit in school. The teaching program thinks they are too young to choose.",
      "options": [
        {
          "id": "a",
          "label": "Full schooling",
          "description": "Everyone stays in school until sixteen. Slower now, stronger later.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "school_hall",
            "module": ""
          },
          "effects": {
            "trust": 2,
            "health": 0.0,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": 3,
            "priority": "safety",
            "power_kw_days": 0,
            "solar_penalty_days": 0
          },
          "result": "The school hall was full every morning. The workshop had to wait."
        },
        {
          "id": "b",
          "label": "Workshop apprenticeships",
          "description": "Half school, half workshop. Construction goes faster, but some learning is lost.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": 1,
            "health": 0.0,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": 2,
            "priority": "expansion",
            "power_kw_days": 0,
            "solar_penalty_days": 0
          },
          "result": "The workshop rang with young voices. The drones were repaired faster than ever."
        },
        {
          "id": "c",
          "label": "Let them choose",
          "description": "Each child chooses for themselves. Some choose wrong. All learn what a choice costs.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": 3,
            "health": 0.0,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": 5,
            "priority": "self_determination",
            "power_kw_days": 0,
            "solar_penalty_days": 0
          },
          "result": "Half chose the workshop. Two came back to school after a month — of their own accord."
        }
      ],
      "fallback": "c"
    },
    {
      "id": "civic_mine_accident",
      "kind": "civic",
      "title": "The mine accident",
      "biome": "",
      "critical": true,
      "trigger": {
        "min_day": 5475,
        "min_population": 20,
        "requires_buildings": [
          "mine"
        ],
        "chance_per_day": 0.02
      },
      "warning_days": 0,
      "warning": "",
      "text": "A tunnel in the mine has collapsed. Ravi, fifteen, was inside with a drone. The drones got him out. He's alive, but his leg is crushed, and the whole colony watched him being carried up.",
      "options": [
        {
          "id": "a",
          "label": "Close the mine until it's secured",
          "description": "The mine closes until the tunnels are shored up. Costs building material and halts extraction for a month.",
          "cost": {
            "alloy": 25,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": 4,
            "health": 0.0,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": 0,
            "priority": "safety",
            "power_kw_days": 0,
            "solar_penalty_days": 0
          },
          "result": "The mine was closed for a month. Ravi was the first to go back in — on crutches, to see the shoring."
        },
        {
          "id": "b",
          "label": "Drones only underground",
          "description": "No people in the mine. The drones take over the work and wear out faster.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": 2,
            "health": 0.0,
            "food": 0,
            "water": 0,
            "wear": 15,
            "autonomy": -3,
            "priority": "safety",
            "power_kw_days": 0,
            "solar_penalty_days": 0
          },
          "result": "The mine became the drones' domain. The young stood at the entrance and watched them vanish into the dark."
        },
        {
          "id": "c",
          "label": "Let the miners decide",
          "description": "The young who work in the mine write the new rules themselves.",
          "cost": {
            "alloy": 0,
            "components": 0,
            "water": 0,
            "food": 0
          },
          "requires": {
            "building": "",
            "module": ""
          },
          "effects": {
            "trust": 3,
            "health": -0.01,
            "food": 0,
            "water": 0,
            "wear": 0,
            "autonomy": 4,
            "priority": "self_determination",
            "power_kw_days": 0,
            "solar_penalty_days": 0
          },
          "result": "They wrote seven rules on a plaque by the entrance. The first read: No one goes alone."
        }
      ],
      "fallback": "c"
    },
    {
