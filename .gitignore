# Godot
.godot/
*.import.tmp
/builds/*
!/builds/README.md
export_credentials.cfg
*.translation

# Raw purchased asset packs never go into git (bible p.23). Import via quarantine.
/assets/quarantine/
/assets/synty_raw/
*.unitypackage
# The repository is PUBLIC: purchased models/textures copied in by tools/synty/stage.py
# stay local too. Rebuild on any machine with tools/synty/build.sh from
# data/art/synty_choices.json (file names only) and the packs in quarantine.
/assets/imported/*
!/assets/imported/README.md

# OS / editor
.DS_Store
Thumbs.db
*.tmp
__pycache__/
/.claude/worktrees/

# Synty Godot-format packs extracted locally (public repo: never committed). Rebuild: tools/synty/unpack_godot.sh
/assets/Synty/
# Animation libraries are keyframes from purchased Synty clips: local only, rebuilt by tools/synty/build_godot_packs.sh
/art/animations/*.res

# Building kits lifted from the Synty demo scenes reference vendor prefabs; regenerate locally with tools/synty/extract_kits.gd
/art/kits/

# Third-party plugins the owner downloaded (Godot 4.7.2, installed locally under
# addons/<plugin>). Not committed until a feature uses one (CLAUDE.md: no addons
# without documented gain); genesis_slots is ours and stays tracked.
/addons/*
!/addons/genesis_slots/

# ElevenLabs output (owner's generations, local like the Meshy models; regenerate with tools/audio/eleven_*.py)
/assets/audio/final/*.mp3
/assets/audio/vo/*.mp3
/tools/audio/eleven_log.jsonl
/assets/audio/raw/
# D-056: the drop pod viewer's baked paint is derived from the owner's Meshy scan (local only)
/evidence/droppod/viewer/drop_pod_baked*
/assets/audio/final/*.mp3.import
/assets/audio/vo/*.mp3.import
/assets/audio/final/*.ogg
/assets/audio/final/*.ogg.import
