; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Genesis Ark"
config/description="Du er det sidste menneske, der kan give menneskeheden en fremtid."
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.043, 0.071, 0.098, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

SettingsService="*res://scripts/autoload/settings_service.gd"
AudioService="*res://scripts/autoload/audio_service.gd"
SaveService="*res://scripts/autoload/save_service.gd"
GameSession="*res://scripts/autoload/game_session.gd"
AppFlow="*res://scripts/autoload/app_flow.gd"
TouchControls="*res://scripts/autoload/touch_controls.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/genesis_slots/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://localization/translations.da.translation")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="buildings"
3d_physics/layer_5="terrain"
3d_physics/layer_6="hazard"

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.043, 0.071, 0.098, 1)
